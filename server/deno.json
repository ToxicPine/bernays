{
  "name": "@bernays/server",
  "version": "0.1.0",
  "exports": {
    "./core": "./core/mod.ts",
    "./events": "./events/mod.ts",
    "./intents": "./intents/mod.ts",
    "./store": "./store/mod.ts",
    "./browsers": "./browsers/mod.ts",
    "./platforms": "./platforms/mod.ts",
    "./views": "./views/mod.ts",
    "./projections": "./projections/mod.ts",
    "./runtime": "./runtime/mod.ts",
    "./briefing": "./briefing/mod.ts"
  },
  "imports": {
    "$/": "./",
    "@std/async": "jsr:@std/async@^1.0.16",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@zod/zod": "jsr:@zod/zod@^4.3.5",
    "@std/uuid": "jsr:@std/uuid@^1.1.0",
    "postgres": "npm:postgres@^3.4.8",
    "effect": "npm:effect@^3.19.14",
    "playwright": "npm:playwright@1.56.1",
    "@browserbasehq/sdk": "npm:@browserbasehq/sdk@^2.6.0"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "paths": {
      "$/*": ["./*"]
    }
  }
}
