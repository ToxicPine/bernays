{
  "name": "@bernays/api",
  "version": "0.1.0",
  "exports": "./src/server.ts",
  "imports": {
    "$/": "./src/",
    "hono": "npm:hono@^4.7.0",
    "hono/logger": "npm:hono@^4.7.0/logger",
    "hono/cors": "npm:hono@^4.7.0/cors",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.2.0",
    "@zod/zod": "jsr:@zod/zod@^4.3.5",
    "effect": "npm:effect@^3.19.14",
    "@bernays/server": "workspace:*",
    "@bernays/plugins": "workspace:*"
  },
  "tasks": {
    "dev": "deno run --allow-all src/main.ts",
    "start": "deno run --allow-all src/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "$/*": ["./src/*"]
    }
  }
}
