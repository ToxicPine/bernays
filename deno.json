{
  "nodeModulesDir": "auto",
  "workspace": [
    "./server",
    "./plugins",
    "./agents",
    "./api",
    "./llm",
    "./tests"
  ],
  "tasks": {
    "dev": "deno run --allow-all agents/src/main.ts",
    "dev:api": "deno run --allow-all api/src/main.ts",
    "test": "deno test --allow-all",
    "check": "deno check server/**/*.ts plugins/**/*.ts agents/**/*.ts api/**/*.ts tests/**/*.ts",
    "test:e2e:all": "deno test --allow-all tests/e2e/"
  }
}
