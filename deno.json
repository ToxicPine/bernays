{
  "nodeModulesDir": "auto",
  "workspace": [
    "./backend/server",
    "./backend/browser",
    "./plugins",
    "./scripts",
    "./agents",
    "./tests"
  ],
  "tasks": {
    "dev": "deno run --allow-all agents/src/main.ts",
    "test": "deno test --allow-all",
    "check": "deno check backend/**/*.ts plugins/**/*.ts agents/**/*.ts scripts/**/*.ts tests/**/*.ts",
    "test:e2e:all": "deno test --allow-all tests/e2e/"
  }
}
