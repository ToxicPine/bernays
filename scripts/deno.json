{
  "version": "0.1.0",
  "imports": {
    "@bernays/plugins": "workspace:*",
    "@bernays/server": "workspace:*",
    "@std/cli": "jsr:@std/cli@^1.0.25",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.21",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "@types/react": "npm:@types/react@^19.2.8",
    "@zod/zod": "jsr:@zod/zod@^4.3.5",
    "effect": "npm:effect@^3.19.14",
    "ink": "npm:ink@^6.6.0",
    "ink-text-input": "npm:ink-text-input@^6.0.0",
    "postgres": "npm:postgres@^3.4.8",
    "react": "npm:react@^19.2.3"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "$/*": ["./*"]
    }
  }
}
